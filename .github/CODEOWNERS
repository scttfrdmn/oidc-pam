# CODEOWNERS file for OIDC PAM
# These owners will be automatically requested for review when someone opens a pull request
# that modifies code in the specified paths.

# Default owner for everything in the repo
* @scttfrdmn

# Security-sensitive components require thorough review
/pkg/pam/ @scttfrdmn
/pkg/security/ @scttfrdmn
/cmd/pam-module/ @scttfrdmn
/cmd/pam-helper/ @scttfrdmn

# Authentication and authorization core. There is deliberately no /pkg/policy/
# entry: that package was removed (#126) and its policy engine now lives in
# /pkg/auth/. A rule for a path that does not exist matches nothing, so it looked
# like coverage while providing none (#147).
/pkg/auth/ @scttfrdmn

# The IPC trust boundary: every PAM login crosses it, and it is where the peer
# credential check and request validation live.
/internal/ipc/ @scttfrdmn

# Loads the token encryption key and every client secret, and enforces the
# configuration file's permissions.
/pkg/config/ @scttfrdmn

# SSH key management
/pkg/ssh/ @scttfrdmn

# Configuration files that affect security
/configs/security/ @scttfrdmn
/configs/pam/ @scttfrdmn

# Build and deployment systems
/.github/workflows/ @scttfrdmn
/Makefile @scttfrdmn
/scripts/ @scttfrdmn

# Security policy and documentation
/SECURITY.md @scttfrdmn
/.github/dependabot.yml @scttfrdmn

# Go module dependencies
/go.mod @scttfrdmn
/go.sum @scttfrdmn
