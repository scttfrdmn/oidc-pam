# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# Build artifacts
/bin/
/build/
/dist/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log files
*.log
/logs/

# Configuration files with secrets.
# Note that configs/production/broker-{minimal,cloud,enterprise}.yaml are tracked
# despite this rule (they are secret-free templates); a new file added there needs
# `git add -f`, which is deliberate -- this directory is where real credentials
# end up.
/configs/local/
/configs/production/
*.env
*.env.local

# Test coverage
coverage.out
coverage.html

# Temporary files
/tmp/

# Documentation build
/docs/_build/

# Local development
/dev/
/local/

# Security scan results
/security/

# Deployment artifacts
/deploy/local/
/deploy/production/

# PAM module artifacts.
# NOT *.h -- the cgo bridge headers (pkg/pam/cgo_bridge.h) are source files, and
# ignoring them meant a new header would be silently skipped by `git add`.
*.o
*.c.o

# Compiled test and helper binaries. These were committed once (19 MB of Mach-O
# arm64 in the repo root); build them with `make` instead.
/integration-test
/test-broker

# Claude Code local state
.claude/
