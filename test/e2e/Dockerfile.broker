# Server side of the end-to-end harness: the broker and the fake identity
# provider it talks to. One image, two services — docker-compose.yml runs it
# twice with different commands — so the certificate the fake presents and the
# certificate the broker trusts cannot drift apart.
#
# Built from the repository working tree, so what a pull request changed is what
# the harness tests.

FROM golang:1.25.13-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# CGO is not needed on this side: the cgo in the tree is confined to
# cmd/pam-module, which belongs to the client image.
RUN CGO_ENABLED=0 go build -trimpath -o /out/oidc-auth-broker ./cmd/broker \
    && CGO_ENABLED=0 go build -trimpath -o /out/oidc-admin ./cmd/oidc-admin \
    && CGO_ENABLED=0 go build -trimpath -o /out/fakeoidc ./test/e2e/fakeoidc

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl openssl \
    && rm -rf /var/lib/apt/lists/*

# The fake issuer has to serve TLS: the broker refuses a plain-http issuer for
# any host but localhost, and container-to-container is not localhost. Generate
# one self-signed certificate here and use it for both roles — the fake presents
# it, and broker.yaml points trusted_ca_bundle at the same file. The SAN matters:
# the broker connects to the compose service name.
RUN mkdir -p /etc/fakeoidc /etc/oidc-auth \
    && openssl req -x509 -newkey rsa:2048 -nodes -days 365 \
        -keyout /etc/fakeoidc/tls.key -out /etc/fakeoidc/tls.crt \
        -subj "/CN=fakeoidc" -addext "subjectAltName=DNS:fakeoidc" \
    && chmod 0600 /etc/fakeoidc/tls.key \
    && cp /etc/fakeoidc/tls.crt /etc/oidc-auth/fakeoidc.crt

COPY --from=builder /out/oidc-auth-broker /out/oidc-admin /out/fakeoidc /usr/local/bin/
# --chmod=600, because COPY's default is 0644 and the broker now refuses to start
# on a configuration any local process can read (#209) — it holds the token
# encryption key and every client secret. The harness runs the real check rather
# than setting OIDC_AUTH_DEV=true to opt out of it: this container is where the
# broker is started the way a host starts it.
COPY --chmod=600 test/e2e/broker.yaml /etc/oidc-auth/broker.yaml

# The broker writes SSH keys and its authorized_keys write locks here (locks/ is
# root-owned and unreachable from the client container, which is the point of
# #161), and audit records to /harness/audit, which docker-compose.yml mounts as a
# volume shared with the client container.
RUN mkdir -p /var/lib/oidc-pam/ssh-keys /var/lib/oidc-pam/locks /var/log/oidc-auth /harness/audit

# The same local accounts the client image has, at the same uids, without home
# directories (the shared /home volume owns those).
#
# The harness splits broker and sshd into two containers to model the IPC trust
# boundary, but a real deployment runs them on one host with one passwd file, and
# the broker relies on that: the privileged-account guard (#159) resolves the
# requested account with getpwnam *in the broker*. If svcacct exists only in the
# client image, the broker sees an account that does not exist locally, allows the
# binding, and the case asserting the guard fires passes nothing.
RUN useradd --no-create-home --shell /usr/sbin/nologin --uid 1001 alice \
    && useradd --no-create-home --shell /usr/sbin/nologin --uid 1002 bob \
    && useradd --no-create-home --shell /usr/sbin/nologin --uid 400 svcacct

CMD ["/usr/local/bin/oidc-auth-broker", "--config", "/etc/oidc-auth/broker.yaml", "--log-level", "debug"]
